# Copy this file to .env for local development.
# Keep every real credential out of Git.

# Required: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=
APP_ENV=development

# Optional AI assistant. Leave the key blank to use the local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Leave blank for local SQLite. Set a new pooled Neon URL in production.
DATABASE_URL=

# Required only for password-recovery email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PhishGuard

PASSWORD_RESET_MAX_AGE=1800
APP_BASE_URL=http://127.0.0.1:5000
RATELIMIT_STORAGE_URI=memory://
COOKIE_SECURE=false
TRUST_PROXY=false
